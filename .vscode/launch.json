  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug executable 'demo'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--bin=demo",
          "--package=demo"
        ]
      },
      "args": []
    },
    {
      "name": "Debug unit tests in executable 'demo'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--bin=demo",
          "--package=demo"
        ]
      }
    },
    {
      "name": "Debug unit tests in library 'embedgine'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--package=embedgine"
        ]
      }
    },
    {
      "name": "Debug unit tests in library 'embedgine_formats'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--package=embedgine-formats"
        ]
      }
    },
    {
      "name": "Debug unit tests in library 'embedgine_build'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--package=embedgine-build"
        ]
      }
    }
  ]
